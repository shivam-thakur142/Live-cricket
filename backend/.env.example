# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database ---
# Default matches the embedded dev database started with `npm run db:start`.
# Point this at any PostgreSQL instance (Neon, Supabase, Railway, local install...).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/scl

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# --- CORS ---
FRONTEND_URL=http://localhost:5173

# --- Seed (development only — never use these in production) ---
SEED_ADMIN_EMAIL=admin@scl.local
SEED_ADMIN_PASSWORD=Admin@123
SEED_EDITOR_EMAIL=editor@scl.local
SEED_EDITOR_PASSWORD=Editor@123
SEED_VIEWER_EMAIL=viewer@scl.local
SEED_VIEWER_PASSWORD=Viewer@123
